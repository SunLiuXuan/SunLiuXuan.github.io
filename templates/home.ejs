<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= profile.name %></title>
<meta name="description" content="<%= profile.intro %>">
<link rel="canonical" href="<%= siteUrl %>/">
<meta property="og:title" content="<%= profile.name %>">
<meta property="og:description" content="<%= profile.intro %>">
<meta property="og:type" content="website">
<script>try{const t=localStorage.getItem('slx-theme');const d=t||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');document.documentElement.dataset.theme=d;document.documentElement.style.colorScheme=d;}catch(e){}</script>
<link rel="stylesheet" href="/css/site.css">
<script defer src="/js/theme.js"></script>
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header wrap">
<a class="brand" href="/">SLX's Homepage</a>
<nav aria-label="Primary navigation"><a href="/projects/">Projects</a><a href="/blogs/">Blogs</a><a href="/about/">About</a><button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle color mode" title="Toggle color mode"><span class="theme-icon theme-icon-light">☀</span><span class="theme-icon theme-icon-dark">☾</span></button></nav>
</header>
<main id="main" class="wrap">
<section class="intro" aria-labelledby="greeting">
<div class="hero">
<img class="portrait" src="<%= profile.avatar %>" alt="<%= profile.name %>" width="148" height="148">
<div><h1 id="greeting"><%= profile.greeting %></h1><p class="tagline"><%= profile.tagline %></p>
<div class="socials" aria-label="Contact links"><% profile.links.forEach(link => { %><a href="<%= link.url %>"><%= link.label %></a><% }); %></div>
</div></div>
<p class="bio"><%= profile.intro %></p>
<p class="interests"><span>Interests</span><%= profile.interests.join(' · ') %></p>
</section>
<section class="section-block" aria-labelledby="news-title">
<div class="section-heading"><h2 id="news-title">News</h2></div>
<ul class="news-list">
<% (profile.news || []).forEach(item => { %>
<li><span class="news-date">[<%= item.date %>]</span> <span class="news-text"><%- item.text %></span></li>
<% }); %>
</ul>
</section>
<section id="projects" class="section-block" aria-labelledby="projects-title">
<div class="section-heading"><h2 id="projects-title">Selected Projects</h2><a class="all-posts" href="/projects/">All projects</a></div>
<div class="project-display-list compact-projects">
<% (profile.projects || []).filter(project => project.featured).forEach(project => { %>
<article class="project-entry">
<% if (project.image) { %>
<a class="project-thumb" href="<%= (project.links && project.links[0] && project.links[0].url) || project.url || '#' %>" aria-label="<%= project.title %>"><img src="<%= project.image %>" alt="<%= project.title %> preview" loading="lazy"></a>
<% } %>
<div class="project-info">
<h3><a href="<%= (project.links && project.links[0] && project.links[0].url) || project.url || '#' %>"><%= project.title %></a><% if (project.year) { %><span class="project-year"><%= project.year %></span><% } %>
<% if (project.links && project.links.length) { %><span class="project-links"><% project.links.forEach(link => { %> <a href="<%= link.url %>">[<%= link.label %>]</a><% }); %></span><% } %>
</h3>
<% if (project.authors) { %><p class="project-authors"><%= project.authors %></p><% } %>
<% if (project.tags && project.tags.length) { %><p class="project-tags"><% project.tags.forEach((tag, index) => { %><span><%= tag %></span><% if (index < project.tags.length - 1) { %><span class="tag-separator">·</span><% } %><% }); %></p><% } %>
<% if (project.summary) { %><p class="project-summary"><%= project.summary %></p><% } %>
</div>
</article>
<% }); %>
</div>
</section>

<section id="writing" class="section-block" aria-labelledby="writing-title">
<div class="section-heading"><h2 id="writing-title">Selected Blogs</h2><a class="all-posts" href="/blogs/">All posts</a></div>
<% writing.forEach(post => { %>
<article class="writing-row"><time datetime="<%= post.date %>"><%= post.date %></time>
<div><h3><a href="<%= post.url %>"><%= post.title %></a></h3><p><%= post.summary %></p></div></article>
<% }); %>
</section>

</main>
<footer class="site-footer wrap"><span>© <%= year %> <%= profile.name %></span><span>Stay curious and energetic.</span></footer>
</body></html>







