<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= page.title || 'About' %> | <%= config.author %></title>
<meta name="description" content="<%= (page.excerpt || page.content || '').replace(/<[^>]*>/g, '').trim().slice(0, 160) %>">
<link rel="canonical" href="<%= full_url_for(page.path) %>">
<script>try{const t=localStorage.getItem('slx-theme');const d=t||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');document.documentElement.dataset.theme=d;document.documentElement.style.colorScheme=d;}catch(e){}</script>
<link rel="stylesheet" href="<%- url_for('/css/site.css') %>">
<script defer src="<%- url_for('/js/theme.js') %>"></script>
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header wrap">
<a class="brand" href="<%- url_for('/') %>">SLX's Homepage</a>
<nav aria-label="Primary navigation"><a href="<%- url_for('/projects/') %>">Projects</a><a href="<%- url_for('/blogs/') %>">Blogs</a><a class="<%= page.path && page.path.indexOf('about/') === 0 ? 'active' : '' %>" href="<%- url_for('/about/') %>">About</a><button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle color mode" title="Toggle color mode"><span class="theme-icon theme-icon-light">☀</span><span class="theme-icon theme-icon-dark">☾</span></button></nav>
</header>
<% const profile = site.data.profile || {}; %>
<% if (page.path && page.path.indexOf('about/') === 0) { %>
<main id="main" class="wrap about-page">
<section class="about-intro" aria-label="About Liuxuan Sun">
<div class="about-copy">
<% (profile.about || '').split(/\n\s*\n/).filter(Boolean).forEach(paragraph => { %><p><%= paragraph.trim() %></p><% }); %>
</div>
<div class="about-media">
<img class="about-photo" src="<%= profile.avatar || '/images/slx1.jpg' %>" alt="<%= profile.name || config.author %>" loading="lazy">
<div class="about-links" aria-label="Contact links"><% (profile.links || []).forEach((link, index) => { %><% if (index) { %><span>/</span><% } %><a href="<%= link.url %>"><%= link.label %></a><% }); %></div>
</div>
</section>

<section class="about-section" aria-labelledby="about-news-title">
<h2 id="about-news-title">News</h2>
<ul class="news-list about-news-list">
<% (profile.news || []).forEach(item => { %><li><span class="news-date">[<%= item.date %>]</span> <span class="news-text"><%- item.text %></span></li><% }); %>
</ul>
</section>

<section class="about-section" aria-labelledby="about-publications-title">
<h2 id="about-publications-title">Publications</h2>
<div class="about-item-list">
<% (profile.publications || []).forEach(pub => { %>
<article class="about-item">
<h3><%= pub.title %><% if (pub.year) { %><span class="project-year"><%= pub.year %></span><% } %><% if (pub.links && pub.links.length) { %><span class="project-links"><% pub.links.forEach(link => { %> <a href="<%= link.url %>">[<%= link.label %>]</a><% }); %></span><% } %></h3>
<% if (pub.authors) { %><p><%= pub.authors %></p><% } %>
<% if (pub.venue) { %><p><em><%= pub.venue %></em></p><% } %>
<% if (pub.summary) { %><p><%= pub.summary %></p><% } %>
</article>
<% }); %>
</div>
</section>

<section class="about-section" aria-labelledby="about-projects-title">
<h2 id="about-projects-title">Projects</h2>
<div class="project-display-list about-project-list">
<% (profile.projects || []).forEach(project => { %>
<article class="project-entry">
<% if (project.image) { %><a class="project-thumb" href="<%= (project.links && project.links[0] && project.links[0].url) || project.url || '#' %>" aria-label="<%= project.title %>"><img src="<%= project.image %>" alt="<%= project.title %> preview" loading="lazy"></a><% } %>
<div class="project-info">
<h3><a href="<%= (project.links && project.links[0] && project.links[0].url) || project.url || '#' %>"><%= project.title %></a><% if (project.year) { %><span class="project-year"><%= project.year %></span><% } %><% if (project.links && project.links.length) { %><span class="project-links"><% project.links.forEach(link => { %> <a href="<%= link.url %>">[<%= link.label %>]</a><% }); %></span><% } %></h3>
<% if (project.authors) { %><p class="project-authors"><%= project.authors %></p><% } %>
<% if (project.tags && project.tags.length) { %><p class="project-tags"><% project.tags.forEach((tag, index) => { %><% if (index) { %><span class="tag-separator">·</span><% } %><%= tag %><% }); %></p><% } %>
<% if (project.summary) { %><p class="project-summary"><%= project.summary %></p><% } %>
</div>
</article>
<% }); %>
</div>
</section>

<section class="about-section" aria-labelledby="about-education-title">
<h2 id="about-education-title">Education</h2>
<div class="education-list">
<% (profile.education || []).forEach(item => { %>
<article class="education-card">
<% if (item.logo) { %><img class="education-logo" src="<%= item.logo %>" alt="<%= item.school %> logo" loading="lazy"><% } %>
<div class="education-main">
<h3><%= item.school %></h3>
<% if (item.degree) { %><p><%= item.degree %></p><% } %>


</div>
<% if (item.period) { %><time class="education-period"><%= item.period %></time><% } %>
</article>
<% }); %>
</div>
</section>

<section class="about-section" aria-labelledby="about-honors-title">
<h2 id="about-honors-title">Honors &amp; Awards</h2>
<ul class="honor-list">
<% (profile.honors || []).forEach(item => { %>
<li>
<div class="honor-row">
<span class="honor-content"><strong><%= item.title %></strong><% if (item.detail) { %> <span><%= item.detail %></span><% } %></span>
<% if (item.year) { %><span class="honor-year"><%= item.year %></span><% } %>
</div>
</li>
<% }); %>
</ul>
</section>
</main>
<% } else { %>
<main id="main" class="wrap plain-page">
<article>
<h1><%= page.title || 'About' %></h1>
<%- page.content %>
</article>
</main>
<% } %>
<footer class="site-footer wrap"><span>© <%= new Date().getFullYear() %> <%= config.author %></span><span><a href="<%- url_for('/') %>">Home</a></span></footer>
</body>
</html>












